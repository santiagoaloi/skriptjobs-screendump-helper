{
  "manifest_version": 3,
  "name": "Skriptjobs - Screendump Helper",
  "version": "1.0.0",
  "description": "Capture clean screenshots for Skriptjobs documentation and issues inside a macOS Chrome mockup frame with selectable wallpapers and Vercel Blob upload.",
  "homepage_url": "https://github.com/santiagoaloi/skriptjobs-screendump-helper",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "clipboardWrite",
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Skriptjobs - Screendump Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/backgrounds/*.png",
        "assets/icons/*.png",
        "shared/frame-renderer.js",
        "html/logs.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
